{
  "info": {
    "_postman_id": "wellsharp-session-json-contract",
    "name": "WellSharp - Session JSON Contract",
    "description": "Examples for the implemented Laravel web and same-origin JSON endpoints. Authenticate with the Login request first, preserve the Laravel session cookie, and provide the CSRF token for state-changing requests. This collection does not use bearer tokens and does not contain real credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "wellsharp_id", "value": "DEMO-ADMIN-001", "description": "A WellSharp ID or username." },
    { "key": "password", "value": "" },
    { "key": "csrf_token", "value": "" },
    { "key": "role", "value": "proctor" },
    { "key": "training_class", "value": "01KZMH1TX1B89J3BTTSPBW04VXJ" },
    { "key": "attempt", "value": "replace-with-attempt-id" },
    { "key": "attempt_question", "value": "1" },
    { "key": "proctor_id", "value": "replace-with-a-proctors-id" },
    { "key": "user", "value": "replace-with-user-public-id" },
    { "key": "student", "value": "replace-with-student-public-id" },
    { "key": "certificate", "value": "replace-with-certificate-id" },
    { "key": "provider", "value": "replace-with-provider-id" },
    { "key": "provider_draft_token", "value": "replace-with-uuid" },
    { "key": "knowledge_control", "value": "replace-with-control-id" },
    { "key": "certificate_number", "value": "replace-with-certificate-number" },
    { "key": "instructor_number", "value": "replace-with-instructor-wellsharp-id" },
    { "key": "document", "value": "replace-with-document-id" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login form",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "text/html" },
              { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "wellsharp_id", "value": "{{wellsharp_id}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          }
        }
      ]
    },
    {
      "name": "Admin data requests",
      "description": "These individual requests cover the admin table JSON endpoints.",
      "item": [
        { "name": "Users", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-Requested-With", "value": "XMLHttpRequest" } ], "url": { "raw": "{{base_url}}/admin/users/data?search=&page=1", "host": ["{{base_url}}"], "path": ["admin", "users", "data"], "query": [ { "key": "search", "value": "" }, { "key": "page", "value": "1" } ] } } },
        { "name": "Students", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/students/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "students", "data"], "query": [ { "key": "page", "value": "1" } ] } } },
        { "name": "Groups", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/groups/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "groups", "data"], "query": [ { "key": "page", "value": "1" } ] } } },
        { "name": "Group search", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/groups/search?q=demo", "host": ["{{base_url}}"], "path": ["admin", "groups", "search"], "query": [ { "key": "q", "value": "demo" } ] } } },
        { "name": "Providers", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/providers/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "providers", "data"], "query": [ { "key": "page", "value": "1" } ] } } },
        { "name": "Subjects", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/subjects/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "subjects", "data"], "query": [ { "key": "page", "value": "1" } ] } } },
        { "name": "Questions", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/questions/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "questions", "data"], "query": [ { "key": "page", "value": "1" } ] } } },
        { "name": "Exams", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/exams/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "exams", "data"], "query": [ { "key": "page", "value": "1" } ] } } },
        { "name": "Exam schedules", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/exam-schedules/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "exam-schedules", "data"], "query": [ { "key": "page", "value": "1" } ] } } },
        { "name": "Classes", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/classes/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "classes", "data"], "query": [ { "key": "page", "value": "1" } ] } } },
        { "name": "Certificates", "request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{base_url}}/admin/certificates/data?page=1", "host": ["{{base_url}}"], "path": ["admin", "certificates", "data"], "query": [ { "key": "page", "value": "1" } ] } } }
      ]
    },
    {
      "name": "Admin configuration",
      "item": [
        {
          "name": "Create reference value",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Managed Pressure\",\n  \"sort_order\": 0\n}" },
            "url": { "raw": "{{base_url}}/admin/subject-configuration/levels", "host": ["{{base_url}}"], "path": ["admin", "subject-configuration", "levels"] }
          }
        },
        {
          "name": "Reorder reference values",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"order\": [3, 1, 2]\n}" },
            "url": { "raw": "{{base_url}}/admin/subject-configuration/levels/reorder", "host": ["{{base_url}}"], "path": ["admin", "subject-configuration", "levels", "reorder"] }
          }
        }
      ]
    },
    {
      "name": "Admin provider locations",
      "description": "Real autosave for create drafts and existing Provider locations. Create drafts are session-owned and do not create Provider rows.",
      "item": [
        {
          "name": "Autosave create Provider location draft",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"locations\": [\n    {\n      \"client_key\": \"location-demo-1\",\n      \"location\": \"123 Training Road\",\n      \"latitude\": 29.971,\n      \"longitude\": 31.128\n    }\n  ]\n}" },
            "url": { "raw": "{{base_url}}/admin/providers/location-drafts/{{provider_draft_token}}", "host": ["{{base_url}}"], "path": ["admin", "providers", "location-drafts", "{{provider_draft_token}}"] }
          }
        },
        {
          "name": "Autosave existing Provider locations",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"locations\": [\n    {\n      \"client_key\": \"location-demo-1\",\n      \"location\": \"123 Training Road\",\n      \"latitude\": 29.971,\n      \"longitude\": 31.128\n    }\n  ]\n}" },
            "url": { "raw": "{{base_url}}/admin/providers/{{provider}}/locations/autosave", "host": ["{{base_url}}"], "path": ["admin", "providers", "{{provider}}", "locations", "autosave"] }
          }
        }
      ]
    },
    {
      "name": "Admin Knowledge score control",
      "description": "Admin-only, reason-required controls. Original attempt scores and answers remain unchanged; certificate lifecycle actions stay explicit.",
      "item": [
        {
          "name": "Add score adjustment",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "text/html" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "urlencoded", "urlencoded": [ { "key": "type", "value": "score_adjustment", "type": "text" }, { "key": "numeric_value", "value": "5", "type": "text" }, { "key": "reason", "value": "Documented Admin correction", "type": "text" } ] },
            "url": { "raw": "{{base_url}}/admin/certificates/{{certificate}}/knowledge-controls", "host": ["{{base_url}}"], "path": ["admin", "certificates", "{{certificate}}", "knowledge-controls"] }
          }
        },
        {
          "name": "Revert Knowledge control",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "text/html" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "urlencoded", "urlencoded": [ { "key": "reason", "value": "Correction no longer applies", "type": "text" } ] },
            "url": { "raw": "{{base_url}}/admin/certificates/{{certificate}}/knowledge-controls/{{knowledge_control}}/revert", "host": ["{{base_url}}"], "path": ["admin", "certificates", "{{certificate}}", "knowledge-controls", "{{knowledge_control}}", "revert"] }
          }
        },
        {
          "name": "Restore calculated Knowledge result",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "text/html" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "urlencoded", "urlencoded": [ { "key": "reason", "value": "Return to calculated result", "type": "text" } ] },
            "url": { "raw": "{{base_url}}/admin/certificates/{{certificate}}/knowledge-controls/restore", "host": ["{{base_url}}"], "path": ["admin", "certificates", "{{certificate}}", "knowledge-controls", "restore"] }
          }
        },
        {
          "name": "Issue eligible certificate",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "text/html" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "url": { "raw": "{{base_url}}/admin/certificates/{{certificate}}/issue", "host": ["{{base_url}}"], "path": ["admin", "certificates", "{{certificate}}", "issue"] }
          }
        },
        {
          "name": "Revoke certificate",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "text/html" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "urlencoded", "urlencoded": [ { "key": "reason", "value": "Administrative revocation", "type": "text" } ] },
            "url": { "raw": "{{base_url}}/admin/certificates/{{certificate}}/revoke", "host": ["{{base_url}}"], "path": ["admin", "certificates", "{{certificate}}", "revoke"] }
          }
        }
      ]
    },
    {
      "name": "Password recovery",
      "description": "Explicit, audited password reveals. Responses contain plaintext credentials; do not save response examples or copy values into collection variables.",
      "item": [
        {
          "name": "Admin reveal account password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "url": { "raw": "{{base_url}}/admin/users/{{user}}/reveal-password", "host": ["{{base_url}}"], "path": ["admin", "users", "{{user}}", "reveal-password"] }
          }
        },
        {
          "name": "Operational reveal Student password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "url": { "raw": "{{base_url}}/{{role}}/students/{{student}}/reveal-password", "host": ["{{base_url}}"], "path": ["{{role}}", "students", "{{student}}", "reveal-password"] }
          }
        },
        {
          "name": "Operational reveal assigned Class roster passwords",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "url": { "raw": "{{base_url}}/{{role}}/classes/{{training_class}}/student-passwords", "host": ["{{base_url}}"], "path": ["{{role}}", "classes", "{{training_class}}", "student-passwords"] }
          }
        }
      ]
    },
    {
      "name": "Operational control",
      "item": [
        {
          "name": "Verify a Proctor's ID",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"proctor_id\": \"{{proctor_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/{{role}}/proctor-id/verify", "host": ["{{base_url}}"], "path": ["{{role}}", "proctor-id", "verify"] }
          }
        },
        {
          "name": "Start or end Class/Exam",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"start\",\n  \"proctor_id\": \"{{proctor_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/{{role}}/classes/{{training_class}}/exam-control", "host": ["{{base_url}}"], "path": ["{{role}}", "classes", "{{training_class}}", "exam-control"] }
          }
        }
      ]
    },
    {
      "name": "Student attempt",
      "item": [
        {
          "name": "Autosave answer",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"answer\": \"true\"\n}" },
            "url": { "raw": "{{base_url}}/student/attempts/{{attempt}}/questions/{{attempt_question}}/answer", "host": ["{{base_url}}"], "path": ["student", "attempts", "{{attempt}}", "questions", "{{attempt_question}}", "answer"] }
          }
        },
        {
          "name": "Expire attempt",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" } ],
            "url": { "raw": "{{base_url}}/student/attempts/{{attempt}}/expire", "host": ["{{base_url}}"], "path": ["student", "attempts", "{{attempt}}", "expire"] }
          }
        }
      ]
    },
    {
      "name": "Certificates and exports",
      "item": [
        {
          "name": "Public certificate search",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "text/html" } ],
            "url": { "raw": "{{base_url}}/iadc_certification?lookup={{instructor_number}}", "host": ["{{base_url}}"], "path": ["iadc_certification"], "query": [ { "key": "lookup", "value": "{{instructor_number}}" } ] }
          }
        },
        {
          "name": "Public certificate verification",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "text/html" } ],
            "url": { "raw": "{{base_url}}/verify/certificates/{{certificate_number}}", "host": ["{{base_url}}"], "path": ["verify", "certificates", "{{certificate_number}}"] }
          }
        },
        {
          "name": "Download certificate PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/certificates/{{certificate}}/documents/{{document}}/download", "host": ["{{base_url}}"], "path": ["certificates", "{{certificate}}", "documents", "{{document}}", "download"] }
          }
        },
        {
          "name": "Export operational certificates CSV",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "text/csv" } ],
            "url": { "raw": "{{base_url}}/{{role}}/certificate/export", "host": ["{{base_url}}"], "path": ["{{role}}", "certificate", "export"] }
          }
        }
      ]
    }
  ]
}
